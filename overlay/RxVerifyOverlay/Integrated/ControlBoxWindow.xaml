<Window x:Class="RxVerifyOverlay.Integrated.ControlBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rx Verify"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Width="420" Height="92"
        Background="#FF1E1E1E"
        BorderBrush="#FF3A3A3A"
        BorderThickness="1">
    <!--
        CONTROL BOX (item 2) — small interactive panel overlaid in
        PioneerRx's own top-right ribbon space (see
        IntegratedOverlayCoordinator's ControlBoxRightInsetDip/
        ControlBoxTopOffsetDip constants for exactly where). UNLIKE
        IntegratedBoxesWindow, this is a NORMAL (non-click-through)
        window — it must receive clicks — so no AllowsTransparency/
        extended-style dance here, just the app's existing dark palette
        (matches MainWindow.xaml's colors) in a borderless, compact
        window that moves with PioneerRx every refresh tick (see
        RepositionPhysical in the code-behind).
    -->
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF2A2A2A" />
            <Setter Property="Foreground" Value="#FFCCCCCC" />
            <Setter Property="BorderBrush" Value="#FF3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF353535" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#FF666666" />
                    <Setter Property="Background" Value="#FF232323" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFCCCCCC" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#FF666666" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <!-- NORMAL content: status summary + toggles + actions, single/two compact rows per spec -->
        <StackPanel x:Name="NormalPanel">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock x:Name="StatusSummaryText" Text="Rx Verify" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusTimeText" Text="" Foreground="#FF888888" FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button x:Name="OpenSeparateButton" Content="Open full view" Margin="10,0,0,0" Click="OnOpenSeparateClick" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Source:" Foreground="#FF888888" FontSize="9" VerticalAlignment="Center" Margin="0,0,4,0" />
                <RadioButton x:Name="MethodOcrRadioButton" GroupName="ControlBoxMethod" Content="OCR" Checked="OnMethodChanged" />
                <RadioButton x:Name="MethodUiaRadioButton" GroupName="ControlBoxMethod" Content="Escript" Checked="OnMethodChanged" />
                <TextBlock Text="View:" Foreground="#FF888888" FontSize="9" VerticalAlignment="Center" Margin="10,0,4,0" />
                <RadioButton x:Name="DisplayIntegratedRadioButton" GroupName="ControlBoxDisplay" Content="Integrated" Checked="OnDisplayModeChanged" />
                <RadioButton x:Name="DisplaySeparateRadioButton" GroupName="ControlBoxDisplay" Content="Separate" Checked="OnDisplayModeChanged" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CopyLogsButton" Content="Copy logs" Margin="0,0,4,0" Click="OnCopyLogsClick" />
                <Button x:Name="CopyLogsNoHipaaButton" Content="Copy logs (no HIPAA)" Click="OnCopyLogsNoHipaaClick" />
            </StackPanel>
        </StackPanel>

        <!--
            MAXIMIZED-ONLY guard (item 3) — shown ON TOP of NormalPanel
            (not instead of it) whenever PioneerRx is attached but not
            maximized; SetMaximizedGuardState also greys every toggle
            except DisplaySeparateRadioButton, so the pharmacist can
            always escape back to Separate without maximizing first.
        -->
        <Border x:Name="MaximizeNoteBorder" Background="#CC1E1E1E" CornerRadius="3" Padding="6,3" VerticalAlignment="Top" HorizontalAlignment="Stretch" Visibility="Collapsed">
            <TextBlock Text="Maximize PioneerRx to use integrated view" Foreground="#FFF9A825" FontSize="10" FontWeight="Bold" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
