<Window x:Class="RxVerifyOverlay.Integrated.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Send feedback — Rx Verify"
        Width="380" SizeToContent="Height"
        MinWidth="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True">
    <!--
        branch fix/rightclick-all-feedback-compact, task 2: compact
        free-text feedback dialog opened from MainWindow's "Feedback"
        button (OnFeedbackClick). Same "normal, activatable window, NOT
        Owner=MainWindow, WindowStartupLocation=CenterScreen"
        posture as Integrated/ReportErrorWindow.xaml — see that file's own
        header doc for why (MainWindow can be hidden in Integrated display
        mode; ShowDialog against a hidden owner is unreliable).

        UNLIKE ReportErrorWindow, there is no per-field prefill here at
        all — just one free-text box. Message is deliberate user speech
        (the branch brief is explicit that this is fine) — nothing
        captured from the screen or the OCR log is ever attached, see
        Reporting/FeedbackPayload.cs's own doc.
    -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Send feedback" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />

        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="11" Foreground="#FF555555" Margin="0,0,0,6"
                   Text="Anything working well, broken, or missing? This goes straight to Will/dev. Nothing from your screen or the app's logs is attached — just what you type below." />

        <TextBox x:Name="MessageTextBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap"
                 Height="100" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" />

        <!--
            Same "not set up" note/disabled-Send pattern as
            Integrated/ReportErrorWindow.xaml's NotSetUpNoteText — see that
            file's own doc for why a missing OverlaySettings.RxVerifyReportKey
            surfaces here instead of the button silently doing nothing.
        -->
        <TextBlock x:Name="NotSetUpNoteText" Grid.Row="3"
                   Text="Error reporting isn't set up on this PC — re-run the pinned setup line from HQ."
                   TextWrapping="Wrap" FontSize="11" FontWeight="Bold" Foreground="#FFB00020" Margin="0,0,0,10"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Padding="12,4" Margin="0,0,8,0" Click="OnCancelClick" IsCancel="True" />
            <Button x:Name="SendButton" Content="Send" Padding="12,4" Click="OnSendClick" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
