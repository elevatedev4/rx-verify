<Window x:Class="RxVerifyOverlay.Integrated.HoverPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rx Verify — field detail"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Focusable="False"
        ShowActivated="False">
    <!--
        Custom hover-detail popup (fix/hover-popup-live branch — REPLACES
        WPF's own ToolTipService, which turned out unreliable in live
        testing on IntegratedBoxesWindow's exotic styles; see
        Integrated/HoverStateMachine.cs's class doc for the full story).
        Driven entirely by IntegratedBoxesWindow's poll timer via
        ShowFor/HidePopup below — never opened/closed by WPF's own
        tooltip machinery, never by user interaction with this window
        itself (it's WS_EX_TRANSPARENT+NOACTIVATE, same as
        IntegratedBoxesWindow's own click-through styles — see
        code-behind's OnSourceInitialized — so it can never steal focus
        or eat a click, and UNLIKE IntegratedBoxesWindow's own dynamic
        toggle, this window's transparency is NEVER cleared — it has
        nothing interactive in it, ever).

        SizeToContent="WidthAndHeight" lets the window size itself to
        whatever field text ShowFor populates (source/entered/explanation
        lengths vary a lot field to field) — code-behind reads
        ActualWidth/ActualHeight AFTER a layout pass to compute where to
        position it (see ShowFor).
    -->
    <!--
        Task 3 (branch fix/rightclick-all-feedback-compact, compact
        overlay): padding/MaxWidth/fonts all tightened ~15-25% from their
        previous values (10,8 / 320 / 13,12,11) — see MainWindow.xaml's own
        Task 3 comment for the matching main-panel changes. Purely cosmetic:
        no field here changed, no behavior/positioning logic (ShowFor still
        reads ActualWidth/ActualHeight after layout, same as before) was
        touched.
    -->
    <Border Background="#FF2B2B2B" BorderBrush="#FF555555" BorderThickness="1" CornerRadius="4" Padding="8,6">
        <StackPanel MaxWidth="270">
            <TextBlock x:Name="FieldNameText" Foreground="White" FontWeight="Bold" FontSize="11" Margin="0,0,0,2" />
            <TextBlock x:Name="StatusText" Foreground="#FFDDDDDD" FontSize="10" />
            <TextBlock x:Name="SourceText" Foreground="#FFDDDDDD" FontSize="10" TextWrapping="Wrap" />
            <TextBlock x:Name="EnteredText" Foreground="#FFDDDDDD" FontSize="10" TextWrapping="Wrap" />
            <TextBlock x:Name="ExplanationText" Foreground="#FFAAAAAA" FontSize="9" FontStyle="Italic" TextWrapping="Wrap" Margin="0,3,0,0" />
        </StackPanel>
    </Border>
</Window>
