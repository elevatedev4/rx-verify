<Window x:Class="RxVerifyOverlay.Reports.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reports — Rx Verify"
        Width="620" Height="560"
        MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <!--
        Reports mode's single non-modal window (GOAL brief step 4) — opened/
        focused from ControlBoxWindow's Mode dropdown ("Mode: Reports"), see
        Integrated/ControlBoxWindow.xaml.cs OnModeComboBoxChanged and
        MainWindow.xaml.cs's ReportsModeRequested handler. A NORMAL
        (activatable) window, same posture as Integrated/ReportErrorWindow —
        it needs keyboard focus for its DatePickers/TextBoxes. Non-modal by
        design (Show(), never ShowDialog()): switching the control box back
        to Verify/Order must not close this window or stop a run in
        progress (GOAL brief: "switching back closes nothing that is
        running").

        Kept deliberately plain WPF, matching the rest of this app's
        styling (see Integrated/ReportErrorWindow.xaml) rather than
        introducing any new visual language.
    -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <!-- Date range -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Begin:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker x:Name="BeginDatePicker" Width="130" Margin="0,0,16,0" />
            <TextBlock Text="End:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker x:Name="EndDatePicker" Width="130" />
        </StackPanel>

        <!-- Output folder -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Save to:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="OutputFolderTextBox" Width="380" Margin="0,0,6,0" />
            <Button x:Name="BrowseButton" Content="Browse…" Padding="10,3" Click="OnBrowseClick" />
        </StackPanel>

        <!-- Report picker / status list -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" x:Name="SelectAllButton" Content="Select all" HorizontalAlignment="Right"
                    Padding="8,2" Margin="0,0,0,4" Click="OnSelectAllClick" />

            <Border Grid.Row="1" BorderBrush="#FFD5D5D5" BorderThickness="1" CornerRadius="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ReportsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#FFEDEDED" BorderThickness="0,0,0,1" Padding="8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" IsEnabled="{Binding IsEnabled}" />
                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#FF555555" TextWrapping="Wrap" MaxWidth="220" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Run / Stop -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
            <Button x:Name="RunButton" Content="Run selected" Padding="14,5" Margin="0,0,8,0" Click="OnRunClick" IsDefault="True" />
            <Button x:Name="StopButton" Content="Stop" Padding="14,5" Click="OnStopClick" IsEnabled="False" />
        </StackPanel>

        <!-- Scrolling log -->
        <Border Grid.Row="4" BorderBrush="#FFD5D5D5" BorderThickness="1" CornerRadius="3">
            <TextBox x:Name="LogTextBox" IsReadOnly="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11" Background="#FFFAFAFA" BorderThickness="0" />
        </Border>
    </Grid>
</Window>
