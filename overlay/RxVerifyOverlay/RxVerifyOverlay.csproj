<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      VERIFY-OCR BRANCH (parallel to main's plain net8.0-windows): bumped
      to a Windows-10 target platform moniker so this UNPACKAGED WPF app
      can call the WinRT Windows.Media.Ocr API (Ocr/WindowsMediaOcrEngine.cs)
      via Windows.Graphics.Imaging.SoftwareBitmap. The .NET SDK auto-adds
      the WinRT projection reference (Microsoft.Windows.SDK.NET.dll /
      WinRT.Runtime.dll) whenever TargetFramework carries a
      "-windows10.0.xxxxx.0" suffix — no extra PackageReference needed for
      that part. 19041.0 (Windows 10 2004) is comfortably below Will's
      Windows 10/11 workstations and is a common, well-trodden TFM for
      this exact "unpackaged desktop app calls WinRT OCR" pattern.

      BUILD RISK TO WATCH (flagged per the branch brief — unverifiable on
      this Mac): this project has never actually been built. The TFM bump
      + implicit WinRT projection is a standard, widely-documented
      pattern (Windows Community Toolkit / MS docs "call WinRT APIs in a
      desktop app"), so confidence is MODERATE-HIGH, but the very first
      `dotnet run` on Windows is the real test — if it doesn't restore/
      build cleanly, the likely culprits are (a) TargetPlatformMinVersion
      too low/high for the installed Windows SDK, or (b) needing an
      explicit <UseWinRT>true</UseWinRT> (newer SDKs default this on
      automatically for a windows10.x TFM, but if not, add it here).
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      RootNamespace/AssemblyName deliberately UNCHANGED from main
      (RxVerifyOverlay) — this is a separate branch, never built
      alongside main, so renaming would only create churn that blocks
      reconciling engine fixes between branches later. Window title +
      an in-window "VerifyOCR" badge (MainWindow.xaml) are what
      distinguish this build visually when run side-by-side with main.
    -->
    <RootNamespace>RxVerifyOverlay</RootNamespace>
    <AssemblyName>RxVerifyOverlay</AssemblyName>
    <!-- Add <ApplicationIcon>Assets\rxverify.ico</ApplicationIcon> once you
         have a real icon file; omitted for v0 so the project builds as-is. -->
    <!--
      INTEGRATED DISPLAY MODE (Integrated/IntegratedOverlayCoordinator.cs):
      declares this app genuinely per-monitor-DPI-aware — see
      app.manifest's header comment for why this matters specifically for
      the click-through boxes layer's pixel-exact positioning over
      PioneerRx on a possibly-secondary, possibly-differently-scaled
      monitor. Harmless for every other existing window/feature (Separate
      mode, OCR capture, etc.) — none of them depended on the previous
      implicit system-DPI-aware default in any way that this changes.
    -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      BUILD FRESHNESS STAMP (W-T92 round 3 — Will: "Literally the action
      hasn't changed at all" after two rounds of date-entry fixes that
      DID land in source. Whatever caused that gap on his machine, the
      fix here is to make every build self-identifying so it can never
      happen silently again): update-and-run.ps1 passes
      -p:RxVerifyBuildSha=<short git sha> -p:RxVerifyBuildTime=<UTC time>
      on every `dotnet build` (see that script). The Condition defaults
      below only apply for a plain `dotnet build`/Visual Studio build
      that didn't pass those properties (e.g. a dev building locally) -
      "local"/the actual build clock time, never blank, so BuildInfo.cs
      always has something real to show.
    -->
    <RxVerifyBuildSha Condition="'$(RxVerifyBuildSha)' == ''">local</RxVerifyBuildSha>
    <!-- Review fix (blocking, matching update-and-run.ps1's own fix):
         space-free ("T" separator) so a value that reaches an MSBuild
         -p: switch some other way (a dev's own manual `dotnet build`
         invocation, say) can never look like two arguments either. -->
    <RxVerifyBuildTime Condition="'$(RxVerifyBuildTime)' == ''">$([System.DateTime]::UtcNow.ToString(`yyyy-MM-ddTHH:mm`))</RxVerifyBuildTime>
    <!--
      This app reads the local screen (via UI Automation AND, on this
      branch, a screen-region OCR capture of the on-screen e-script image
      — see Ocr/EscriptImageCapture.cs) and calls a local Node subprocess.
      It never opens a socket, never calls a remote API. It now DOES write
      one new local-only diagnostic log by construction (the OCR raw-text/
      timing log, Ocr/OcrLogger.cs, %TEMP%\VerifyOCR\ocr-*.log) in addition
      to the optional debug tree-dump file the pharmacist explicitly
      triggers — both stay on the local workstation. See README.md
      "Local-only, by construction" for the full audit.
    -->
    <!--
      Velopack installer channel (feat/velopack-installer, mirrors
      vaccine-assist's identical change). Suppresses the WPF SDK's
      auto-generated Main() (App.xaml's Build Action stays
      "ApplicationDefinition" so InitializeComponent() is still generated —
      only the paired Main() is suppressed) so Program.cs can provide its
      own, calling VelopackApp.Build().Run() first. See Program.cs's doc
      comment for the full explanation — Microsoft's own documented
      mechanism for a custom WPF entry point, not a hack.

      Both DefineConstants and StartupObject are needed together (same CI
      fix vaccine-assist hit): DISABLE_XAML_GENERATED_MAIN alone doesn't
      reliably suppress the generated Main in every build (the *_wpftmp
      intermediate project can still see two Main() methods and fail with
      CS0017 "Program has more than one entry point defined"); StartupObject
      is MSBuild's equivalent of the compiler's /main flag and makes the
      intent unambiguous either way.
    -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>RxVerifyOverlay.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- FlaUI wraps UIA2/UIA3 COM interop with a much friendlier, more
         testable API than raw System.Windows.Automation, and its
         RawViewWalker is exactly what we need to read PioneerRx's
         Not-Focusable text nodes (see Uia/UiaTreeWalker.cs). -->
    <PackageReference Include="FlaUI.Core" Version="4.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <!--
      System.Drawing.Common: Bitmap/Graphics.CopyFromScreen for the
      no-tab-switch screen-region capture (Ocr/EscriptImageCapture.cs).
      NOT part of the Microsoft.WindowsDesktop.App shared framework by
      default on .NET 6+ even for WPF apps — must be referenced
      explicitly. Works fine on Windows (the only place this branch ever
      runs); this repo never targets non-Windows, so the "GDI+ only
      works on Windows" caveat on this package doesn't apply here.
    -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />

    <!--
      Velopack installer channel: real Setup.exe + self-update as an
      ADDITIONAL channel alongside the existing bootstrap-fresh.ps1 +
      shortcut flow, which must keep working exactly as today — see
      Velopack/VelopackUpdater.cs's gate on UpdateManager.IsInstalled for
      how that's enforced. Same version as vaccine-assist's identical
      channel (newest stable release on nuget.org as of 2026-09-29).
    -->
    <PackageReference Include="Velopack" Version="1.2.161" />

    <!--
      Velopack's own NuGet package has NO client-side S3 update source
      (verified against github.com/velopack/velopack tag 1.2.161 —
      Sources/ only ships GithubSource/GitlabSource/GiteaSource/
      SimpleWebSource/SimpleFileSource/VelopackFlowSource; S3 support is
      CLI-only, for `vpk upload/download s3`, i.e. for PUSHING a release,
      not for an app to pull one). Velopack/S3UpdateSource.cs implements
      the missing client-side half directly against S3 using this SDK, for
      the private-bucket + embedded-read-only-key design (mirrors
      vaccine-assist's identical channel).
    -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.4" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Read-only S3 credentials for update checks — see
      Velopack/release-source.example.json (committed, placeholders only)
      and this repo's .gitignore. The SDK's default item globs already pick
      this file up as a "None" item when it exists (it's just another file
      under the project directory) — this only ADDS the copy-to-output
      metadata to that existing item (via Update=, not Include=, so there's
      no duplicate-item conflict with the implicit glob). Condition="Exists(...)"
      means a checkout without this file (every checkout except a
      workstation deliberately configured for it) builds exactly as before —
      VelopackUpdater logs once and skips update checks entirely when it's
      missing (see ReleaseSourceConfig.Load).
    -->
    <None Update="Velopack\release-source.json" Condition="Exists('Velopack\release-source.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- BUILD FRESHNESS STAMP: embeds RxVerifyBuildSha/RxVerifyBuildTime (see
       above) as AssemblyMetadataAttribute values, read back at runtime by
       Update/BuildInfo.cs - no custom code-gen target needed, this is the
       standard MSBuild-supported way to bake build-time values into the
       assembly. -->
  <ItemGroup>
    <AssemblyMetadata Include="RxVerifyBuildSha" Value="$(RxVerifyBuildSha)" />
    <AssemblyMetadata Include="RxVerifyBuildTime" Value="$(RxVerifyBuildTime)" />
  </ItemGroup>

</Project>
