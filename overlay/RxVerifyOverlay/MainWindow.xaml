<Window x:Class="RxVerifyOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RxVerifyOverlay.Models"
        xmlns:vm="clr-namespace:RxVerifyOverlay.ViewModels"
        Title="VerifyOCR"
        Width="390" Height="480"
        MinWidth="320" MinHeight="260"
        Topmost="True"
        WindowStartupLocation="Manual"
        ResizeMode="CanResizeWithGrip"
        Background="#FF1E1E1E">
    <!--
        Always-on-top (Topmost="True" — a hard requirement: the
        pharmacist needs this visible over PioneerRx at all times), and
        freely movable/resizable like any normal window (drag the title
        bar, drag the resize grip) so Will can park it wherever fits his
        monitor layout. Left/Top are just an initial position, not a
        pin — WPF remembers wherever the user drags it for the rest of
        that run; persisting position across launches is a nice-to-have,
        not done in v0 (see README "Deferred").

        W-T11 item 4: Left is deliberately NOT set here (was a fixed
        Left="20", i.e. hugging the LEFT edge) — it's computed in
        MainWindow.xaml.cs's constructor from the primary screen's
        working-area width so the window launches near the RIGHT edge
        instead, since Left="20" here would just be overwritten before
        the window is shown anyway.

        W-T13 item 2: Top is likewise deliberately NOT set here (was a
        fixed Top="20", i.e. hugging the very top of the screen) — it's
        now computed in MainWindow.xaml.cs's constructor as ~200px down
        from the work area's top, clamped on-screen the same way Left
        is, so the window no longer launches crammed against the top
        edge.
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="GreenBrush" Color="#FF2E7D32" />
        <SolidColorBrush x:Key="YellowBrush" Color="#FFF9A825" />
        <SolidColorBrush x:Key="RedBrush" Color="#FFC62828" />
        <!-- NeutralBrush now doubles as the GRAY field-row background
             (see the Rows ItemsControl's row Border.Style below,
             VerdictRowViewModel.BarColor) — lighter than the always-on
             card background (BoxGrayBrush, #FF2A2A2A) so an unreadable
             row still reads as its own distinct band on the card, the
             same way BoxGreen/Yellow/RedBrush read as bands via hue;
             gray has no hue to lean on, so it leans on this luminance
             step instead. -->
        <SolidColorBrush x:Key="NeutralBrush" Color="#FF3A3A3A" />
        <!-- GrayBrush: the GRAY field bar's glyph/icon color (see
             VerdictRowViewModel.BarColor / FieldBarColorMapper) — a field
             that could not actually be read/compared from the source
             (not_provided, unparseable_date, unparseable_quantity), as
             opposed to YellowBrush which still means "read both sides,
             needs a human glance." Same "full-strength accent color for
             glyph text, muted Box* variant for the row fill" split as
             Green/Yellow/Red below. -->
        <SolidColorBrush x:Key="GrayBrush" Color="#FF555555" />

        <!-- Muted/dark variants of the same hues for the WHOLE category
             box background (not just the header strip); full-strength
             GreenBrush/YellowBrush/RedBrush across an entire card would
             wash out the white row text, so the box uses a darker tint of
             the same color while the header keeps the bold version. -->
        <SolidColorBrush x:Key="BoxGreenBrush" Color="#FF1B3A1E" />
        <SolidColorBrush x:Key="BoxYellowBrush" Color="#FF4A3B12" />
        <SolidColorBrush x:Key="BoxRedBrush" Color="#FF4A1F1F" />
        <SolidColorBrush x:Key="BoxGrayBrush" Color="#FF2A2A2A" />

        <!--
            W-T9 item 3: buttons were "too bright" (default WPF chrome is
            light gray/white), which draws the eye away from the verdict
            list — the actual point of the overlay. This implicit Style
            (no x:Key, so it applies to EVERY Button in the window,
            toolbar and Settings expander alike) recolors them close to
            the window's own #FF1E1E1E background: a subtle dark gray
            fill with a slightly lighter border for definition and
            legible (but low-contrast, non-attention-grabbing) light-gray
            text. Hover/pressed states get a small step up in brightness
            so the button still visibly responds to interaction without
            being bright at rest.
        -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF2A2A2A" />
            <Setter Property="Foreground" Value="#FFCCCCCC" />
            <Setter Property="BorderBrush" Value="#FF3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <!-- Task 3: 8,3 -> 6,2 (~25%/33% smaller) -->
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF353535" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF404040" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            Compaction round 2 (branch fix/verify-overlay-compact2, owner
            verbatim: "still too big and not efficient... talking about
            Verify overlay, not Order"). Round 1 (fix/rightclick-all-
            feedback-compact, see the Grid.Margin comment below) only
            trimmed padding/font sizes ~15-25%; this round goes after the
            actual wasted SPACE — merging the Source/View toggles from two
            stacked rows into one (see Grid.Row="1" below) needs a compact
            grouping chrome instead of the old "Source:"/"View:" text
            labels, borrowed from the identical pattern already proven in
            Integrated/ControlBoxWindow.xaml's own Round 9 ("thin grouping
            border replacing text labels") — same idea, dark-palette
            variant to match this window's #FF1E1E1E background instead of
            ControlBoxWindow's light Pioneer-ribbon palette.
        -->
        <Style x:Key="ToggleGroupBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF262626" />
            <Setter Property="BorderBrush" Value="#FF3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

    </Window.Resources>

    <!--
        Task 3 (branch fix/rightclick-all-feedback-compact): the whole
        panel's margins/paddings/some font sizes below are tightened
        ~15-25% from their previous values so the overlay takes noticeably
        less screen space over PioneerRx. Does NOT touch
        Integrated/BoxLayoutAdjuster.cs's box geometry (PaddingDip/
        FlushGapThreshold) — those align to Pioneer's own on-screen
        fields, not this panel's chrome, and are out of scope for this
        task.

        Compaction round 2 (branch fix/verify-overlay-compact2): round 1
        above only trimmed padding/fonts; owner tested it and said it was
        "still too big and not efficient." This round targets actual
        wasted space rather than more font/padding shaving (data fonts
        stay at FontSize 9-10, the floor for arm's-length readability):
        Width/Height cut from 420x720 to 390x480 (~38% less screen area),
        the Source/View toggle rows merged from two stacked Auto rows into
        one (see the single Grid.Row="1" below — was rows 1 AND 2, now
        just 1, so every row index from the verdict list down shifted up
        by one), and outer/inner margins tightened further throughout.
        Window stays ResizeMode="CanResizeWithGrip" and position is NOT
        persisted across launches (computed fresh from Width/Height in
        the constructor every run — see the Left/Top comment above), so
        shrinking the defaults here doesn't disturb any saved state.
    -->
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Title -->
            <RowDefinition Height="Auto" /> <!-- Source + View toggles, merged into one row (round 2) -->
            <RowDefinition Height="*" />    <!-- Verdict list (fixed order, never resorted) — the main content -->
            <RowDefinition Height="Auto" /> <!-- W-T11 item 6: e-script notes, red text, only when present -->
            <RowDefinition Height="Auto" /> <!-- VerifyOCR: OCR status line + raw-text expander -->
            <RowDefinition Height="Auto" /> <!-- Bottom bar: status message + Refresh/Dump/Auto-watch controls -->
            <RowDefinition Height="Auto" /> <!-- Settings (collapsible-ish, just always shown small in v0) -->
        </Grid.RowDefinitions>

        <!--
            Row 0: title + a small "VerifyOCR" badge so it's obvious which
            build is running when this and the main Rx Verify overlay are
            open side by side (this branch deliberately keeps the window
            Title itself as the only OTHER identity marker — see
            RxVerifyOverlay.csproj header for why namespace/assembly stay
            unchanged). The green/yellow/red summary count pills that used
            to live here were removed per Will's W-T9 item 2 feedback (not
            needed — the per-category header rollups below already convey
            this).
        -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Task 3: 16 -> 13 (~19%) -->
                <TextBlock Text="Rx Verify" Foreground="White" FontSize="13" FontWeight="Bold" />
                <Border Background="#FF2E7D32" CornerRadius="3" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="MethodBadgeText" Text="OCR" Foreground="White" FontSize="9" FontWeight="Bold" />
                </Border>
            </StackPanel>
            <!--
                Task 2 (branch fix/rightclick-all-feedback-compact):
                compact "Feedback" button — top-right of the title row so
                it's always visible without competing for space with the
                verdict list below (the actual point of the overlay). Small
                font/padding to stay unobtrusive; opens
                Integrated/FeedbackWindow (see OnFeedbackClick).
            -->
            <Button Grid.Column="1" x:Name="FeedbackButton" Content="Feedback" FontSize="9" Padding="6,2"
                    VerticalAlignment="Center" Click="OnFeedbackClick"
                    ToolTip="Send feedback about Rx Verify" />
        </Grid>

        <!--
            Row 1: runtime source-method toggle (combine "Verify" (UIA/
            Escript-tab read) and "VerifyOCR" (screen-OCR read) into one
            app where the pharmacist picks at runtime) AND the INTEGRATED
            DISPLAY MODE toggle (Integrated — verdict boxes drawn
            directly over PioneerRx + a small control panel in its ribbon,
            see Integrated/IntegratedOverlayCoordinator.cs, the default —
            vs. Separate, this standalone window, the original behavior),
            merged onto ONE row (round 2 compaction — was two stacked
            rows). OCR/Integrated stay the defaults (see
            Models/OverlaySettings.cs VerificationMethod/DisplayMode).
            Switching source immediately saves settings and triggers a
            fresh RefreshAsync (see OnMethodChanged in MainWindow.xaml.cs)
            so the change takes effect right away instead of waiting for
            the next auto-watch tick; the active method is also reflected
            in the badge above (MethodBadgeText). The View toggle is the
            ONLY way to switch INTO Integrated mode — once there, this
            window hides itself (see MainWindow.xaml.cs
            HideSeparateWindowRequested) and the control box's OWN
            identical toggle (Integrated/ControlBoxWindow.xaml) is what
            lets the pharmacist switch back, plus an "Open full view"
            button that reveals this window again without changing the
            mode. Grouping borders (ToggleGroupBorderStyle) replace the
            old "Source:"/"View:" text labels and the old "(default)"/
            "(over PioneerRx...)" content suffixes — same de-duplication
            already proven in Integrated/ControlBoxWindow.xaml's Round 9 —
            a ToolTip on each group still spells out what it's for.
        -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
            <Border Style="{StaticResource ToggleGroupBorderStyle}" ToolTip="Verification source: OCR screen-read (default) or direct Escript-tab read">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="MethodOcrRadioButton" GroupName="VerificationMethod" Content="OCR"
                                 Foreground="#FFCCCCCC" FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0"
                                 IsChecked="True" Checked="OnMethodChanged" />
                    <RadioButton x:Name="MethodUiaRadioButton" GroupName="VerificationMethod" Content="Escript"
                                 Foreground="#FFCCCCCC" FontSize="9" VerticalAlignment="Center" Checked="OnMethodChanged" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ToggleGroupBorderStyle}" ToolTip="Display mode: Integrated over PioneerRx (default) or this Separate window">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="DisplayIntegratedRadioButton" GroupName="DisplayMode" Content="Integrated"
                                 Foreground="#FFCCCCCC" FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0"
                                 IsChecked="True" Checked="OnDisplayModeChanged" />
                    <RadioButton x:Name="DisplaySeparateRadioButton" GroupName="DisplayMode" Content="Separate"
                                 Foreground="#FFCCCCCC" FontSize="9" VerticalAlignment="Center" Checked="OnDisplayModeChanged" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!--
            Row 2 (was Row 3 before round 2's toggle-row merge): compact
            grouped table — 3 categories (Patient /
            Prescriber / Rx, see Models/EngineModels.cs
            FieldCategories), each with a rolled-up status header
            (worst-status-wins: any Red field -> Red header, else any
            Yellow -> Yellow, else Green) and its field rows below in
            small print, FIXED PHARMACIST FIELD ORDER within the category
            (never re-sorted — hard requirement: rows must mirror the
            data-entry screen's order, never jump around by severity).
            Binds directly to OverlayViewModel.Categories (built/rolled-up
            every refresh in OverlayViewModel.RefreshAsync), which is
            already in FieldCategories.Order — Patient, Prescriber, Rx
            (sig now lives inline at the bottom of Rx, along with drug,
            since both are inherently fuzzy matches — see
            FieldCategories.CategoryByField doc). Reason code +
            explanation are NOT always-visible text (that's what made the
            old per-field-card layout tall) — they're a hover tooltip on
            the row instead (VerdictRowViewModel.TooltipText), so the
            whole table stays small enough to see all fields at once for
            a normal Rx without scrolling. This is now the main content,
            given the full remaining vertical space (Height="*") — the
            toolbar/status controls that used to live above it moved to
            the bottom bar below (W-T9 item 1).
        -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Column header labels for the compact table below (round 2: Margin/Field-col width tightened to match the field rows' own glyph+name columns below, 18+50 -> 16+44 = 60) -->
            <Grid Grid.Row="0" Margin="3,0,3,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" MinWidth="70" />
                    <ColumnDefinition Width="*" MinWidth="70" />
                    <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Field" Foreground="#FF888888" FontSize="9" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="Source" Foreground="#FF888888" FontSize="9" FontWeight="Bold" Margin="3,0,0,0" />
                <TextBlock Grid.Column="2" Text="Entered" Foreground="#FF888888" FontSize="9" FontWeight="Bold" Margin="3,0,0,0" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--
                                Box background is a FIXED neutral (no longer
                                tinted by the category's rolled-up status —
                                per Will's rework request, that signal now
                                lives on each individual field row below AND
                                as the header's status text (see
                                CategoryViewModel.StatusText), not on the box
                                itself; a box-wide color plus a per-row color
                                plus a header-strip color was one coloring
                                layer too many).
                            -->
                            <Border Background="{StaticResource BoxGrayBrush}" BorderBrush="#FF3A3A3A" BorderThickness="1" CornerRadius="4" Margin="0,0,0,2">
                                <StackPanel>
                                    <!--
                                        Category header (W-T11 item 1: REWORKED back to a
                                        plain, quiet heading — this REVERSES the earlier
                                        W-T9 item 4 styling above; W-T13 item 1: re-tuned
                                        from muted-gray-on-gray to bold-white-on-window-bg).
                                        The rolled-up status glyph and "— <StatusText>"
                                        label (e.g. "Match" / "Partial match" / "Verify")
                                        are gone entirely — per Will's feedback, the header
                                        was drawing the eye when the field ROWS below (which
                                        already carry the same green/yellow/red whole-row
                                        coloring, see the Rows ItemsControl below) are the
                                        thing that should be looked at. The header row's
                                        Background is set to the window's own #FF1E1E1E
                                        (not the card's BoxGrayBrush behind it) so it forms
                                        no distinct band/tint of its own — it visually
                                        punches through the card into the window background
                                        — while the text is bold WHITE so the category name
                                        still reads clearly at a glance.
                                        CategoryViewModel.Glyph/StatusText/HeaderStatusText
                                        still exist in code (still covered by
                                        Tests/CategoryStatusTextTests.cs) — they're simply no
                                        longer bound anywhere in this template.
                                    -->
                                    <Border Background="#FF1E1E1E">
                                        <!-- Task 3: 11 -> 9 (~18%); round 2: Margin 4,2,0,2 -> 3,1,0,1 -->
                                        <TextBlock Text="{Binding Name}" Foreground="#FFFFFFFF" FontWeight="Bold" FontSize="9" Margin="3,1,0,1" />
                                    </Border>

                                    <!--
                                        Field rows: status icon | Field | Source | Entered, with
                                        the WHOLE ROW colored uniformly by that row's own bar
                                        color (green/yellow/gray/red, VerdictRowViewModel.BarColor
                                        — see FieldBarColorMapper) — reworked per Will's live-test
                                        feedback, replacing the old scheme where the Source cell
                                        stayed neutral and only the Entered cell was tinted
                                        (Twinlist-style split). One color across the whole row
                                        reads faster at a glance than tracking which of two cells
                                        is colored. The leading glyph remains the WCAG-required
                                        non-color-only signal. GRAY (2026-08-17 fix round, Will
                                        verbatim: "gray if it wasn't able to be read") is a field
                                        that could not actually be read/compared from the source at
                                        all — distinct from YELLOW, which means both sides WERE
                                        read and the engine wants a human glance (fuzzy match,
                                        deliberately-capped-severity difference like address, etc.)
                                        — see BarColor's own doc for the full split.
                                    -->
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Task 3: Margin 0,1.5 -> 0,1, Padding 4,1.5 -> 3,1; round 2: Margin 0,1 -> 0,0.5,0,0.5, Padding 3,1 -> 3,0.5 -->
                                                <Border CornerRadius="3" Margin="0,0.5,0,0.5" Padding="3,0.5" ToolTipService.ToolTip="{Binding TooltipText}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource BoxGreenBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding BarColor}" Value="{x:Static vm:FieldBarColor.Yellow}">
                                                                    <Setter Property="Background" Value="{StaticResource BoxYellowBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding BarColor}" Value="{x:Static vm:FieldBarColor.Gray}">
                                                                    <Setter Property="Background" Value="{StaticResource NeutralBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding BarColor}" Value="{x:Static vm:FieldBarColor.Red}">
                                                                    <Setter Property="Background" Value="{StaticResource BoxRedBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <!-- round 2: glyph/name columns 18+50 -> 16+44 (matches the header row's Field column above, now 60 total), giving Source/Entered a bit more room at the narrower 390px window width -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="16" />
                                                            <ColumnDefinition Width="44" />
                                                            <ColumnDefinition Width="*" MinWidth="70" />
                                                            <ColumnDefinition Width="*" MinWidth="70" />
                                                        </Grid.ColumnDefinitions>

                                                        <!--
                                                            Column 0: leading status glyph (WCAG: icon is the
                                                            PRIMARY signal, color reinforces). "✓" / "!" / "✗" —
                                                            never a color-only dot.

                                                            PENDING (drug row only, while its background
                                                            lookup is still running — see
                                                            VerdictRowViewModel.IsPending and
                                                            OverlayViewModel.RefreshAsync's two-phase
                                                            refresh): swap the glyph for a small
                                                            indeterminate spinner instead of the yellow "!" —
                                                            a "needs a look" glyph would misleadingly imply a
                                                            real verdict was already reached.
                                                        -->
                                                        <Grid Grid.Column="0">
                                                            <!-- Task 3: 12 -> 10 (~17%) -->
                                                            <TextBlock Text="{Binding Glyph}" FontWeight="Bold" FontSize="10" TextAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding BarColor}" Value="{x:Static vm:FieldBarColor.Yellow}">
                                                                                <Setter Property="Foreground" Value="{StaticResource YellowBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding BarColor}" Value="{x:Static vm:FieldBarColor.Gray}">
                                                                                <Setter Property="Foreground" Value="{StaticResource GrayBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding BarColor}" Value="{x:Static vm:FieldBarColor.Red}">
                                                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <ProgressBar IsIndeterminate="True" Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <ProgressBar.Style>
                                                                    <Style TargetType="ProgressBar">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ProgressBar.Style>
                                                            </ProgressBar>
                                                        </Grid>

                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="#FFBBBBBB" FontSize="9" TextWrapping="Wrap" VerticalAlignment="Center" />

                                                        <!--
                                                            Column 2: Source value — plain text, no per-cell
                                                            background; the row's own Border (above) is what
                                                            now carries the match-state color, uniformly
                                                            across both Source and Entered.
                                                        -->
                                                        <TextBlock Grid.Column="2" Text="{Binding SourceValue}" Foreground="White" FontSize="9" TextWrapping="Wrap" Margin="1,0" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontFamily" Value="Segoe UI" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsTabularField}" Value="True">
                                                                            <Setter Property="FontFamily" Value="Consolas" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!--
                                                            Column 3: Entered value — plain text, same
                                                            uniform-row-color treatment as Source above.
                                                            Mismatches (red) still render the entered text
                                                            BOLD so a real discrepancy visually pops more
                                                            than a match recedes. Tabular/digit fields (NPI,
                                                            phone, quantity, refills) use a monospace font so
                                                            a transposed digit is visible as column
                                                            misalignment, not just a string diff.
                                                        -->
                                                        <TextBlock Grid.Column="3" Text="{Binding EnteredValue}" Foreground="White" FontSize="9" TextWrapping="Wrap" Margin="1,0" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontWeight" Value="Normal" />
                                                                    <Setter Property="FontFamily" Value="Segoe UI" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:VerdictStatus.Red}">
                                                                            <Setter Property="FontWeight" Value="Bold" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsTabularField}" Value="True">
                                                                            <Setter Property="FontFamily" Value="Consolas" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!--
            Row 3 (was Row 2/4 before round 2's row merge; W-T11 item 6): e-script notes (NCPDP Note element, see
            Parsing/EscriptTreeParser.ParseNotes and
            OverlayViewModel.Notes/HasNotes) — RED text, at the BOTTOM of
            the overlay (below the verdict table, above the bottom
            controls bar), and only rendered at all when at least one
            note was found. Collapsed via HasNotes so an Rx with no notes
            (the common case) shows nothing here at all — no empty red
            box.
        -->
        <StackPanel Grid.Row="3">
            <Border Margin="0,3,0,0" Padding="0,0,0,3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNotes}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ItemsControl ItemsSource="{Binding Notes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#FFEF5350" FontSize="10" FontWeight="Bold"
                                       TextWrapping="Wrap" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!--
                Task 1b (non-escript blank state): "Rx is not an escript"
                banner — same red/bold TEXT STYLE as the e-script Notes
                banner directly above (reusing its visual language per
                the brief, not its collection — see
                OverlayViewModel.NonEscriptMessage doc for why these stay
                separate properties). Visible only while
                HasNonEscriptMessage is true (OCR path only; the Uia path
                never sets this — it has its own SourceUnavailableReason
                status-message flow instead).
            -->
            <Border Margin="0,3,0,0" Padding="0,0,0,3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNonEscriptMessage}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding NonEscriptMessage}" Foreground="#FFEF5350" FontSize="10" FontWeight="Bold"
                           TextWrapping="Wrap" Margin="0,1" />
            </Border>
        </StackPanel>

        <!--
            Row 4 (was Row 3/5 before round 2's row merge; VerifyOCR): always-visible OCR timing/char-count status
            line (branch brief item 3 — the headline diagnostic: proving
            capture+OCR speed and letting Will judge text quality on his
            real screen) plus a collapsed-by-default expander showing the
            full raw OCR text from the last read. Ocr/OcrLogger.cs writes
            the same numbers + full text to %TEMP%\VerifyOCR\ocr-*.log on
            every read, for a permanent record — this is the live/
            in-the-moment view of the same data.
        -->
        <StackPanel Grid.Row="4" Margin="0,0,0,2">
            <!--
                Task 2 (OCR reading indicator): small indeterminate
                spinner next to the OCR status line, visible only while
                OverlayViewModel.IsOcrReading is true (set immediately
                before/after the ReadSourceFromOcrAsync await — see
                RefreshFromOcrAsync). Copies the exact same
                ProgressBar/DataTrigger pattern as the drug row's pending
                spinner above (Row 2's IsPending ProgressBar) rather than
                inventing new spinner chrome. Purely cosmetic — the
                property flips either side of an await that was already
                running, so this cannot slow down capture/OCR itself.
            -->
            <StackPanel Orientation="Horizontal">
                <ProgressBar IsIndeterminate="True" Width="10" Height="10" Margin="0,0,5,0" VerticalAlignment="Center">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOcrReading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <TextBlock Text="{Binding OcrStatusText}" Foreground="#FF9CCC65" FontSize="10" TextWrapping="Wrap" />
            </StackPanel>
            <Expander Header="Raw OCR text (last read)" Foreground="#FFBBBBBB" FontSize="10" Margin="0,2,0,0">
                <TextBox Text="{Binding LastOcrRawText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         AcceptsReturn="True" MaxHeight="150" VerticalScrollBarVisibility="Auto"
                         Background="#FF141414" Foreground="#FFDDDDDD" FontFamily="Consolas" FontSize="10"
                         BorderBrush="#FF3A3A3A" Margin="0,2,0,0" Padding="4" />
            </Expander>
        </StackPanel>

        <!--
            Row 5 (was Row 4/6 before round 2's row merge): BOTTOM BAR (W-T9 item 1) — Refresh, "Dump UIA Tree",
            the Auto-watch checkbox, and the "last checked"/status text
            all moved down here from the old top toolbar, so the verdict
            list above gets the space and the pharmacist's eye starts on
            data, not controls. Status message (which includes "Last
            checked h:mm:ss" — see OverlayViewModel.RefreshAsync/
            RefreshDrugFieldAsync) sits above the button row, both inside
            one bottom-anchored block.
        -->
        <Border Grid.Row="5" BorderBrush="#FF2A2A2A" BorderThickness="0,1,0,0" Margin="0,2,0,0" Padding="0,2,0,0">
            <StackPanel>
                <!--
                    Task 4 (branch fix/rightclick-all-feedback-compact):
                    "Update ready" banner — collapsed by default, shown by
                    code-behind (MainWindow.xaml.cs CheckForUpdateAsync/
                    ApplyUpdateBannerState) when Diagnostics/UpdateChecker's
                    pure IsUpdateAvailable comparison finds the latest
                    origin/main commit differs from this build's own
                    AppDiagnostics.GetCommitSha(). "Update" launches the
                    pinned bootstrap one-liner in a new PowerShell process
                    and exits this app (OnUpdateClick) — see UpdateLauncher's
                    own doc for the exact command construction.
                -->
                <Border x:Name="UpdateBannerBorder" Background="#FF1B3A1E" BorderBrush="#FF2E7D32" BorderThickness="1"
                        CornerRadius="3" Padding="6,3" Margin="0,0,0,4" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="Update ready" Foreground="#FF9CCC65" FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button x:Name="UpdateButton" Content="Update" FontSize="9" Padding="6,2" Click="OnUpdateClick" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding StatusMessage}" Foreground="#FFBBBBBB" FontSize="10"
                           TextWrapping="Wrap" Margin="0,0,0,2" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Refresh" Margin="0,0,6,0" Click="OnRefreshClick" />
                    <!--
                        2026-08-13 (RXVERIFY-TROUBLESHOOT): the plain
                        "Copy logs" button (redactPatient: false — includes
                        raw patient name/DOB/address in the title, verdict
                        rows, and raw OCR text/word list) was removed per
                        owner request. "Copy logs (no HIPAA)" below is the
                        only copy action now — same debugging blob, with
                        patient identifiers redacted. See
                        OverlayViewModel.BuildCurrentLogBlob /
                        Diagnostics/RxLogFormatter.cs.
                    -->
                    <!--
                        "Copy logs (no HIPAA)" — one-click clipboard copy of
                        everything needed to debug the CURRENTLY-DISPLAYED Rx
                        (parsed/mapped fields, match verdicts, warnings/
                        errors, app version + commit, OCR word geometry),
                        with all patient identifiers (name, DOB, address —
                        title, verdict rows, raw OCR text + word list)
                        redacted, so a REAL prescription's log can be pasted
                        for debugging without exposing PHI.
                        Prescriber/drug/sig/qty/refills/dates and the OCR
                        geometry are preserved. See
                        OverlayViewModel.BuildCurrentLogBlob(redactPatient:
                        true) / Diagnostics/RxLogFormatter.cs.
                    -->
                    <Button Content="Copy logs (no HIPAA)" Margin="0,0,6,0" Click="OnCopyLogsNoHipaaClick" />
                    <Button Content="Dump UIA Tree..." Margin="0,0,6,0" Click="OnDumpTreeClick" />
                    <!--
                        W-T11 item 3: DEFAULT ON — checked by construction
                        (IsChecked="True") so watching begins automatically
                        at launch instead of requiring a manual click every
                        session. See MainWindow.xaml.cs constructor for how
                        the timer is actually started to match this initial
                        state (Checked doesn't reliably fire off of the XAML
                        default before the timer field exists).
                    -->
                    <CheckBox x:Name="AutoRefreshCheckBox" Content="Auto-watch" Foreground="#FFCCCCCC" VerticalAlignment="Center"
                              IsChecked="True" Checked="OnAutoRefreshToggled" Unchecked="OnAutoRefreshToggled" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Row 6 (was Row 5/7 before round 2's row merge): engine path settings, always visible in v0 (small footprint, no PHI); collapsed by default (IsExpanded not set) so it costs only its header's height until opened -->
        <Expander Grid.Row="6" Header="Engine settings" Foreground="White" Margin="0,2,0,0">
            <StackPanel Margin="0,6,0,0">
                <TextBlock Text="rx-verify dist/cli.js path:" Foreground="#FFBBBBBB" FontSize="11" />
                <Grid Margin="0,2,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CliPathTextBox" Grid.Column="0" Padding="4" />
                    <Button Grid.Column="1" Content="Browse..." Margin="4,0,0,0" Click="OnBrowseCliPathClick" />
                </Grid>

                <TextBlock Text="Node executable (usually just 'node'):" Foreground="#FFBBBBBB" FontSize="11" />
                <TextBox x:Name="NodeExeTextBox" Padding="4" Margin="0,2,0,6" />

                <!--
                    VerifyOCR capture-region override (see
                    Models/OverlaySettings.cs and
                    Ocr/EscriptImageCapture.cs ResolveCaptureRegion).
                    Default (unchecked) auto-detects the center Escript
                    pane's on-screen bounds — this section only matters if
                    that auto-detection doesn't land on the right part of
                    Will's screen.
                -->
                <TextBlock Text="OCR capture region (advanced — leave unchecked to auto-detect the Escript pane):"
                           Foreground="#FFBBBBBB" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                <CheckBox x:Name="UseExplicitCaptureRegionCheckBox" Content="Use explicit region below" Foreground="#FFCCCCCC" Margin="0,2,0,4" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,3,0">
                        <TextBlock Text="Left" Foreground="#FF888888" FontSize="9" />
                        <TextBox x:Name="CaptureRegionLeftTextBox" Padding="4" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="3,0,3,0">
                        <TextBlock Text="Top" Foreground="#FF888888" FontSize="9" />
                        <TextBox x:Name="CaptureRegionTopTextBox" Padding="4" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="3,0,3,0">
                        <TextBlock Text="Width" Foreground="#FF888888" FontSize="9" />
                        <TextBox x:Name="CaptureRegionWidthTextBox" Padding="4" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="3,0,0,0">
                        <TextBlock Text="Height" Foreground="#FF888888" FontSize="9" />
                        <TextBox x:Name="CaptureRegionHeightTextBox" Padding="4" />
                    </StackPanel>
                </Grid>

                <Button Content="Save settings" HorizontalAlignment="Left" Click="OnSaveSettingsClick" />
            </StackPanel>
        </Expander>
    </Grid>
</Window>
